{
  "name": "omapen-extension",
  "version": "0.1.0",
  "scripts": {
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --test host/test/",
    "e2e": "ng build && node e2e/smoke.mjs",
    "package": "ng build && node scripts/package.mjs",
    "host:install": "node host/install.mjs",
    "host:uninstall": "node host/install.mjs --uninstall"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@stempelv/ng-builders": "^2.0.0",
    "@types/chrome": "^0.3.7",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.2"
  },
  "description": "Help me write, with your own local AI agent: a browser extension that rewrites the text in any field.",
  "license": "MIT"
}
